{
  "name": "human-or-ai-carousel",
  "private": true,
  "description": "Builds the React Bits Circular Carousel into ../carousel/ so the static site needs no build step to run.",
  "scripts": {
    "build": "esbuild main.tsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../carousel/carousel.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
